diff --git a/web/src/index.css b/web/src/index.css
index 7c4f39f9d40..fe2a3bfdf06 100644
--- a/web/src/index.css
+++ b/web/src/index.css
@@ -271,3 +271,121 @@ html[dir="rtl"] {
   direction: rtl;
 }
 
+/* Plugins page: soften the Select trigger + dropdown panel. The UI library's
+   Select renders its own hardcoded classes (no radius prop), so scope a
+   radius to the two direct children of the .plugins-select wrapper. */
+[data-plugins-page] .plugins-select > button,
+[data-plugins-page] .plugins-select > div {
+  border-radius: 10px;
+}
+
+/* App-wide: switches. The UI-lib Switch renders both states in gray (the
+   on/off difference is hard to read) and its knob span has NO radius (a
+   square knob inside the pill track looked clashing). Round the knob, use a
+   moderate track radius, and tint the on-state with the success color.
+   (Attribute+element specificity beats the library's hardcoded classes.) */
+button[role="switch"] {
+  border-radius: 8px;
+}
+button[role="switch"] > span {
+  border-radius: 9999px;
+}
+button[role="switch"][aria-checked="true"] {
+  background-color: color-mix(in srgb, var(--color-success) 20%, transparent);
+  border-color: color-mix(in srgb, var(--color-success) 45%, transparent);
+}
+button[role="switch"][aria-checked="true"] > span {
+  background-color: var(--color-success);
+}
+
+/* App-wide: Select (dropdown). The UI-lib Select hardcodes `font-courier`
+   (a Courier-style display face — unclear at small sizes) and 70%-light
+   option text; that face's unusual line metrics also make the trigger label
+   (e.g. 内置 / 默认) sit visibly below center. Use the theme's standard font
+   and full-strength text, and normalize the line-height. */
+button[role="combobox"],
+[role="listbox"] [role="option"] {
+  font-family: var(--theme-font-sans);
+  letter-spacing: normal;
+}
+button[role="combobox"] span,
+[role="listbox"] [role="option"] span {
+  line-height: 1.5;
+}
+button[role="combobox"] span {
+  color: var(--midground);
+}
+[role="listbox"] [role="option"] {
+  color: var(--midground);
+}
+
+/* App-wide: Label. The UI-lib Label hardcodes font-mondwest (display face,
+   uppercase) + leading-none; that short line box makes labels sitting next to
+   switches (e.g. 自动更新) render ~4px above the track center, and the face is
+   unclear at 12px. Use the theme's standard font with a normal line-height so
+   the text centers on the switch (and matches the body copy). `html label`
+   gives attribute+element specificity to beat the library's utility classes. */
+html label {
+  font-family: var(--theme-font-sans);
+  text-transform: none;
+  letter-spacing: normal;
+  line-height: 1.5;
+}
+
+/* App-wide: rounded corners. The UI-lib primitives are hard-edged (no
+   border-radius by default) and do not consume theme radius variables.
+   PluginsPage is the rounded reference (cards rounded-2xl, controls
+   rounded-lg, pills rounded-xl); these plain rules — unlayered, so they
+   outrank Tailwind's @layer utilities and the library's hardcoded
+   classes — bring every other page to the same look in one place. */
+
+/* Cards: the Card primitive is the only component that hardcodes
+   border-midground/15 + bg-background-base/80, so this hook covers every
+   <Card> (including cards that carry rounded-none from upstream). */
+div.border-midground\/15.bg-background-base\/80 {
+  border-radius: 16px;
+}
+
+/* Dialog panels. */
+[data-slot='dialog-content'] {
+  border-radius: 16px;
+}
+
+/* Buttons. Switches keep their own rule above (higher specificity). */
+button {
+  border-radius: 8px;
+}
+
+/* Form fields. */
+input:not([type='checkbox']):not([type='radio']),
+textarea {
+  border-radius: 8px;
+}
+
+/* Select trigger + dropdown panel (plugins-select keeps its own 10px rule). */
+button[role='combobox'],
+[role='listbox'] {
+  border-radius: 8px;
+}
+
+/* Code chips & blocks. */
+code,
+pre {
+  border-radius: 8px;
+}
+
+/* Status badges -> pills: Badge is the only bordered span rendered in the
+   compressed display face (typography spans carry the face but no border,
+   so the radius is invisible on them). */
+span.font-compressed {
+  border-radius: 9999px;
+}
+
+/* MCP page: the DS's global `code` chip (selection-highlight background,
+   `*::selection, code` in @nous-research/ui globals.css) is too heavy for
+   the endpoint URLs / commands in the server cards. Scoped to the page
+   root so every other page keeps the chip look. */
+[data-mcp-page] code {
+  background: transparent;
+  color: inherit;
+}
