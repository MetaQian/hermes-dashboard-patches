+/**
+ * Shared UI conventions for list/card pages.
+ *
+ * BADGE_CN — compact badge styling for CJK. The UI-lib Badge defaults
+ * (font-compressed display face, text-display size, 0.2em tracking) look
+ * oversized and misaligned next to 12px Chinese labels. Override per usage:
+ * `<Badge tone="..." className={BADGE_CN}>`.
+ */
+export const BADGE_CN =
+  "rounded-full px-1.5 py-0.5 font-sans text-[0.625rem] tracking-[0.05em] normal-case";
